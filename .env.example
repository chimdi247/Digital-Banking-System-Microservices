# =============================================================================
# Digital Banking System — environment configuration
#
# Copy this file to `.env` in the repo root and fill in real values:
#   cp .env.example .env
#
# `docker-compose.yml` reads this file automatically. Do NOT commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL (backs account-service, transaction-service, payment-service)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# JWT signing secret — shared between account-service (issues tokens) and
# api-gateway (validates them). Must be at least 32 characters (HS256 needs a
# 256-bit key). The value below is a real random 64-char hex string generated
# for this file — fine to use as-is for local dev, but generate your own for
# anything beyond that:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=77d52c7f95f81ac1b64489facd340fb5704a4a1d03ca072d88bd6c801f08b995

# -----------------------------------------------------------------------------
# Razorpay (payment-service — required for the Top Up / Payments page)
# Get test keys from https://dashboard.razorpay.com/app/keys
# Note: Razorpay confirms payments via webhook, which needs a publicly
# reachable URL. On localhost this means the webhook will never fire unless
# you tunnel it (e.g. ngrok) and configure that URL in the Razorpay dashboard.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Cross-origin / frontend URLs
#
# ALLOWED_ORIGINS is used server-side by api-gateway's CORS config — the
# origin(s) the browser will be calling from.
#
# VITE_API_BASE_URL is baked into the frontend's JS bundle at *build* time,
# so it must be a URL the visitor's BROWSER can reach — your host's public
# IP/domain and the api-gateway's port (8080 by default), NOT an internal
# Docker service name. If you change this later you must rebuild the
# frontend image (`docker compose up -d --build frontend`) — editing .env
# alone will not update an already-built image.
#
# Defaults below assume you're running everything on your own machine.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://35.226.68.168:3000,http://localhost:3000,http://localhost:5173

VITE_API_BASE_URL=/api


# -----------------------------------------------------------------------------
# Host ports (optional overrides — defaults shown)
# -----------------------------------------------------------------------------
# FRONTEND_PORT=3000
# KAFKA_UI_PORT=8090

# -----------------------------------------------------------------------------
# Redis Commander (Redis UI): http://localhost:8091
# -----------------------------------------------------------------------------
# REDIS_COMMANDER_PORT=8091
# REDIS_COMMANDER_USER=admin
# REDIS_COMMANDER_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Observability (see observability/README.md)
#
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT is baked into the frontend's JS bundle at
# *build* time, same caveat as VITE_API_BASE_URL above: it must be a URL the
# visitor's BROWSER can reach (the otel-collector's OTLP/HTTP port, published
# to the host), not the internal otel-collector:4318 Docker hostname.
# -----------------------------------------------------------------------------
# GRAFANA_PORT=3001
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=admin
# PROMETHEUS_PORT=9091
# LOKI_PORT=3100
# TEMPO_PORT=3200
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=/otlp

# Where CPU/memory alert emails go (observability/grafana/provisioning/alerting/).
# Delivery needs GF_SMTP_ENABLED=true plus real SMTP credentials below --
# alerts still fire and show in the Grafana UI without them, they just won't
# email out.
ALERT_EMAIL_TO=shimdi247@gmail.com
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
